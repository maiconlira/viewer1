# ── Obrigatórias ─────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:senha@host:5432/agencia"
ADMIN_PASSWORD="troque-esta-senha"          # senha do painel (único administrador)
SESSION_SECRET="string-aleatoria-longa"      # assina o cookie de sessão
APP_URL="https://sua-agencia.up.railway.app" # usado nos links de aprovação/contrato
AGENCY_NAME="Minha Agência"
TZ="America/Sao_Paulo"                        # fuso usado nas datas e agendamentos

# ── IA (Claude) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# CLAUDE_MODEL="claude-opus-5"

# ── WhatsApp: escolha um provedor ─────────────────────────────
# WHATSAPP_PROVIDER="evolution" | "meta" | "none" (none = modo simulação, só registra)
WHATSAPP_PROVIDER="none"
# Evolution API (self-hosted, conecta via QR Code)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
# WhatsApp Cloud API oficial (Meta)
META_WA_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
META_WA_VERIFY_TOKEN=""
META_APP_SECRET=""                           # valida a assinatura dos webhooks da Meta
# Segredo opcional exigido no webhook (?secret=...)
WEBHOOK_SECRET=""

# ── Geração de imagens e vídeos (fal.ai) ─────────────────────
FAL_KEY=""
FAL_IMAGE_MODEL="fal-ai/flux/dev"
FAL_VIDEO_MODEL="fal-ai/kling-video/v2.1/standard/text-to-video"

# ── Automação ─────────────────────────────────────────────────
CRON_SECRET="outra-string-aleatoria"          # protege /api/cron/tick
