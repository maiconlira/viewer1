# ── Obrigatórias ─────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:senha@host:5432/agencia"
ADMIN_PASSWORD="troque-esta-senha"          # senha do painel (único administrador)
SESSION_SECRET="string-aleatoria-longa"      # assina o cookie de sessão
ENCRYPTION_KEY="outra-string-aleatoria-longa" # criptografa tokens (Meta/Google) no banco — não troque depois de conectar
APP_URL="https://sua-agencia.up.railway.app" # usado nos links de aprovação/contrato
AGENCY_NAME="Minha Agência"
AGENCY_TZ="America/Sao_Paulo"                 # fuso da agência (agenda, vencimentos, relatórios)

# ── IA (Claude) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# CLAUDE_MODEL="claude-opus-5"

# ── WhatsApp: escolha um provedor ─────────────────────────────
# WHATSAPP_PROVIDER="evolution" | "meta" | "none" (none = modo simulação, só registra)
WHATSAPP_PROVIDER="none"
# Evolution API (self-hosted, conecta via QR Code)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
# WhatsApp Cloud API oficial (Meta)
META_WA_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
META_WA_VERIFY_TOKEN=""
META_APP_SECRET=""                           # valida a assinatura dos webhooks da Meta
# Segredo opcional exigido no webhook (?secret=...)
WEBHOOK_SECRET=""

# ── Geração de imagens e vídeos (fal.ai) ─────────────────────
FAL_KEY=""
FAL_IMAGE_MODEL="fal-ai/flux/dev"
FAL_VIDEO_MODEL="fal-ai/kling-video/v2.1/standard/text-to-video"

# ── Automação ─────────────────────────────────────────────────
CRON_SECRET="outra-string-aleatoria"          # protege /api/cron/tick

# ── Instagram / Facebook (publicação automática e métricas) ──
# App em developers.facebook.com com o produto "Login do Facebook" e redirect {APP_URL}/api/meta/callback
META_APP_ID=""
# META_APP_SECRET acima também é usado aqui

# ── Mercado Pago (cobrança com Pix/boleto/cartão e baixa automática) ──
MP_ACCESS_TOKEN=""                            # Credenciais de produção → Access token
MP_WEBHOOK_SECRET=""                          # Webhooks → assinatura secreta (opcional, recomendado)

# ── Google Agenda (reuniões com Google Meet) ──
# Google Cloud → APIs → Google Calendar API + credencial OAuth "Aplicativo da Web"
# URI de redirecionamento: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cloudflare R2 (upload de fotos e vídeos) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="agencia-midia"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"       # domínio público do bucket (ou domínio próprio)
